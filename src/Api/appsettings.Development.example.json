{
  "Application": {
    "ApiRoutePrefix": "api/v1"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=vonboarding_db;Username=postgres;Password=YOUR_POSTGRES_PASSWORD"
  },
  "Jwt": {
    "Secret": "YOUR_LOCAL_JWT_SECRET_AT_LEAST_32_CHARACTERS_LONG"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "PasswordReset": {
    "TokenTtlMinutes": 20,
    "FrontendBaseUrl": "http://localhost:4200"
  },
  "EmailSettings": {
    "Provider": "SMTP",
    "FromEmail": "no-reply@example.com",
    "FromName": "Vitreous Onboarding",
    "SmtpHost": "",
    "SmtpPort": 587,
    "Username": "",
    "Password": ""
  },
  "Seed": {
    "Enabled": true,
    "AdminUsername": "admin",
    "AdminPassword": "ChangeMe123!"
  },
  "Users": {
    "EmailDomain": "company.local"
  }
}
